# Bu dosyayı .env olarak kopyalayın ve parolayı değiştirin. .env depoya girmez.
POSTGRES_DB=gks
POSTGRES_USER=gks
POSTGRES_PASSWORD=degistirin

# ADR-020: uygulama kısıtlı veritabanı kullanıcısıyla bağlanır (POSTGRES_USER yalnızca Flyway migration'ları için).
# Parola POSTGRES_PASSWORD'den farklı olmalı. Mevcut kurulumu güncelleme: docs/operations/db-roles.md
GKS_DB_APP_USER=gks_app
GKS_DB_APP_PASSWORD=degistirin-uygulama

# Backend sırları (bootRun bu dosyayı ortama yükler). Her biri Base64, 32 bayt:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GKS_JWT_SIGNING_KEY=
GKS_TOTP_ENCRYPTION_KEY=
GKS_INVITATION_HASH_KEY=
GKS_IDEMPOTENCY_HASH_KEY=

# Tek seferlik ilk yönetici (LD-54): yalnızca kurumda aktif ADM yokken kullanılır.
# İlk web girişinde TOTP kurulumu ve parola değişikliği zorunludur.
GKS_BOOTSTRAP_ADMIN_EMAIL=
GKS_BOOTSTRAP_ADMIN_PASSWORD=
